# AudioCloning 环境变量示例（复制为 .env 后按需修改；运行时前缀 AUDIOCLONE_）
# 完整说明见 docs/USER-GUIDE.md §4.1

# ── 默认后端 ────────────────────────────────────────────────
AUDIOCLONE_TTS_BACKEND=cosyvoice3-mlx
AUDIOCLONE_ASR_BACKEND=qwen3-asr-llama

# ── 音频 / 参考音频校验 ────────────────────────────────────
AUDIOCLONE_SAMPLE_RATE=24000
AUDIOCLONE_REF_AUDIO_MAX_SEC=30
AUDIOCLONE_REF_AUDIO_MIN_SEC=1
AUDIOCLONE_REF_AUDIO_MIN_SR=8000
AUDIOCLONE_MAX_TEXT_LENGTH=300

# ── WebUI ──────────────────────────────────────────────────
AUDIOCLONE_GRADIO_PORT=7860
AUDIOCLONE_GRADIO_HOST=127.0.0.1
AUDIOCLONE_GRADIO_MAX_QUEUE=4
AUDIOCLONE_GRADIO_CONCURRENCY=2

# ── ASR ────────────────────────────────────────────────────
AUDIOCLONE_ASR_SERVER_HOST=127.0.0.1
AUDIOCLONE_ASR_SERVER_PORT=8090
AUDIOCLONE_ASR_CTX_SIZE=4096
AUDIOCLONE_ASR_N_GPU_LAYERS=99
AUDIOCLONE_ASR_AUDIO_MAX_SEC=300
AUDIOCLONE_ASR_SAMPLE_RATE=16000
AUDIOCLONE_ASR_HTTP_TIMEOUT=120.0
AUDIOCLONE_ASR_READY_TIMEOUT=60.0
AUDIOCLONE_ASR_MAX_SEGMENT_SEC=60.0
AUDIOCLONE_ASR_CHUNK_OVERLAP_SEC=1.0

# ── 上传 / 输出 ─────────────────────────────────────────────
AUDIOCLONE_MAX_UPLOAD_BYTES=104857600
AUDIOCLONE_OUTPUT_KEEP_MAX=0

# ── 合成体验（v0.2.2） ─────────────────────────────────────
AUDIOCLONE_TTS_NORMALIZE_LOUDNESS=false
AUDIOCLONE_TTS_SEGMENT_GAP_SEC=0.15

# ── 日志（v0.2.2） ─────────────────────────────────────────
AUDIOCLONE_LOG_JSON=false

# ── 部署：API 服务覆盖 TTS 模型目录（非 AUDIOCLONE_ 前缀） ──
# COSYVOICE_MODEL_DIR=/absolute/path/to/model
